---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  canonical?: string;
}

const {
  title,
  description,
  image = 'https://glidexavpn.com/images/og-image.png',
  type = 'website',
  canonical,
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, 'https://glidexavpn.com').href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="GlideXAVPN" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <slot name="schema" />
  </head>
  <body class="font-geist">
    <slot name="top" />
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/carousel.ts';

      // Lightweight, Privacy-First Analytics Tracker
      try {
        const devType = window.innerWidth < 768 ? 'mobile' : window.innerWidth < 1024 ? 'tablet' : 'desktop';
        const apiUrl = 'https://glidexa-cms-api.muhamadjajuni-code.workers.dev/api/analytics/track';

        // 1. Pageview
        const pvData = JSON.stringify({
          event_type: 'pageview',
          path: window.location.pathname,
          device_type: devType,
          referrer: document.referrer || 'direct'
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon(apiUrl, pvData);
        } else {
          fetch(apiUrl, { method: 'POST', body: pvData, keepalive: true, headers: { 'Content-Type': 'application/json' } });
        }

        // 2. Click Tracker
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement)?.closest('a');
          if (!target) return;
          const href = target.getAttribute('href') || '';
          let eventName = null;
          if (href.includes('play.google')) eventName = 'click_playstore';
          else if (href.includes('wa.me')) eventName = 'click_whatsapp';
          else if (href.includes('#pricing')) eventName = 'click_pricing';

          if (eventName) {
            const clkData = JSON.stringify({
              event_type: 'click',
              path: window.location.pathname,
              event_name: eventName,
              device_type: devType
            });
            if (navigator.sendBeacon) {
              navigator.sendBeacon(apiUrl, clkData);
            } else {
              fetch(apiUrl, { method: 'POST', body: clkData, keepalive: true, headers: { 'Content-Type': 'application/json' } });
            }
          }
        });
      } catch {}
    </script>
  </body>
</html>
