---
import Base from '../../layouts/Base.astro';
import { getPublishedArticles, getArticleBySlug, CMS_API_URL } from '../../lib/api';
import { marked } from 'marked';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  if (!articles || articles.length === 0) {
    return [{ params: { slug: 'selamat-datang-di-glidexa-cms' } }];
  }
  return articles.map((art) => ({
    params: { slug: art.slug },
  }));
}

const { slug } = Astro.params;
const allArticles = await getPublishedArticles();
const initialArticle = slug ? await getArticleBySlug(slug) : null;
const relatedArticles = allArticles.filter((a) => a.slug !== slug).slice(0, 3);

const articleUrl = `https://glidexavpn.com/blog/${slug}`;
const parsedHtml = initialArticle?.content ? marked.parse(initialArticle.content) : '';

const wordCount = initialArticle?.content ? initialArticle.content.trim().split(/\s+/).length : 0;
const readTimeMin = Math.max(1, Math.ceil(wordCount / 200));

const articleSchema = initialArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: initialArticle.title,
      description: initialArticle.excerpt,
      image: initialArticle.thumbnail_url || 'https://glidexavpn.com/images/og-image.png',
      url: articleUrl,
      datePublished: initialArticle.published_at,
      dateModified: initialArticle.published_at,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': articleUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: 'GlideXAVPN',
        logo: {
          '@type': 'ImageObject',
          url: 'https://glidexavpn.com/images/logo.svg',
        },
      },
      author: {
        '@type': 'Organization',
        name: 'Tim Editorial GlideXAVPN',
      },
    }
  : null;

function formatDate(dateStr?: string) {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleDateString('id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}
---

<Base
  title={initialArticle ? `${initialArticle.title} - GlideXAVPN Blog` : 'Artikel - GlideXAVPN'}
  description={initialArticle?.excerpt || 'Baca artikel dan tips gaming terbaru dari GlideXAVPN.'}
  image={initialArticle?.thumbnail_url || 'https://glidexavpn.com/images/og-image.png'}
  type="article"
  canonical={articleUrl}
>
  {articleSchema && (
    <script type="application/ld+json" slot="schema" set:html={JSON.stringify(articleSchema)} />
  )}

  <article class="relative w-full overflow-clip bg-page" data-api={CMS_API_URL} data-slug={slug}>
    <!-- Article Header -->
    <header class="relative w-full border-b border-line bg-page">
      <div class="glow-top relative mx-auto flex w-full max-w-[1000px] flex-col items-center gap-6 border-x border-line px-6 pt-20 pb-12 sm:px-12 lg:pt-[90px]">
        <div class="pointer-events-none absolute top-[-2px] left-0 h-[486px] w-full overflow-hidden mix-blend-hard-light">
          <img alt="" class="absolute top-0 left-0 h-[110.08%] w-[103.55%] max-w-none" src="/images/bg-texture.png" />
        </div>

        <!-- Breadcrumb & Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2.5 font-mono text-xs text-muted-2">
          <a href="/blog" class="text-azure-64 hover:underline">&larr; Kembali ke Blog</a>
          <span>&bull;</span>
          <span id="article-cat" class="rounded bg-surface-2 px-2.5 py-1 text-soft">
            {initialArticle?.category || 'General'}
          </span>
          <span>&bull;</span>
          <span class="text-muted">⏱️ {readTimeMin} min baca</span>
        </div>

        <!-- Article Title -->
        <h1
          id="article-title"
          class="relative max-w-[880px] text-center font-mono text-2xl leading-snug font-medium text-strong sm:text-4xl sm:leading-tight lg:text-[46px] lg:leading-[1.25]"
        >
          {initialArticle?.title || 'Memuat Artikel...'}
        </h1>

        <!-- Excerpt -->
        {initialArticle?.excerpt && (
          <p id="article-excerpt" class="relative max-w-[760px] text-center font-geist text-base text-muted sm:text-lg leading-relaxed">
            {initialArticle.excerpt}
          </p>
        )}

        <!-- Author Meta Info -->
        <div class="relative flex items-center gap-3.5 pt-4 border-t border-line/60">
          <div class="flex size-10 items-center justify-center rounded-full bg-surface-2 border border-line text-ping font-mono text-sm font-bold">
            GX
          </div>
          <div class="flex flex-col text-left">
            <span class="font-geist text-sm font-semibold text-text">Tim Editorial GlideXAVPN</span>
            <div class="flex items-center gap-2 font-mono text-xs text-muted-2">
              <time id="article-date" datetime={initialArticle?.published_at}>
                {formatDate(initialArticle?.published_at)}
              </time>
              <span>&bull;</span>
              <span class="text-ok">✓ Terverifikasi</span>
            </div>
          </div>
        </div>

        <!-- Social Share Bar -->
        <div class="relative flex items-center gap-2 pt-2">
          <span class="font-mono text-xs text-muted-2 mr-1">Bagikan:</span>
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent((initialArticle?.title || '') + ' ' + articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-xs text-text hover:border-[#25D366] hover:text-[#25D366] transition-colors"
          >
            <span>💬 WhatsApp</span>
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(initialArticle?.title || '')}&url=${encodeURIComponent(articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-xs text-text hover:border-azure-51 hover:text-azure-51 transition-colors"
          >
            <span>𝕏 Twitter</span>
          </a>
          <button
            type="button"
            id="btn-copy-url"
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-xs text-text hover:border-ping hover:text-ping transition-colors cursor-pointer"
          >
            <span>📋 Salin Link</span>
          </button>
        </div>

        <!-- Featured Thumbnail Banner -->
        {initialArticle?.thumbnail_url && (
          <div id="article-banner" class="relative mt-4 w-full max-w-[920px] overflow-hidden rounded-2xl border border-line shadow-2xl">
            <img
              src={initialArticle.thumbnail_url}
              alt={initialArticle.title}
              class="w-full max-h-[460px] object-cover"
            />
          </div>
        )}
      </div>
    </header>

    <!-- Article Content Reader Section -->
    <main class="relative mx-auto flex w-full max-w-[1000px] flex-col border-x border-line bg-page px-6 py-12 sm:px-12 lg:py-16">
      <div
        id="article-content"
        class="reader-content font-geist text-text leading-relaxed text-base sm:text-lg"
        set:html={parsedHtml}
      />

      <!-- Article Footer Banner / CTA -->
      <div class="mt-16 rounded-2xl border border-azure-51/40 bg-gradient-to-r from-blue-8 to-surface p-8 text-center sm:p-10">
        <h3 class="font-mono text-xl sm:text-2xl font-medium text-strong">
          Rasakan Bermain Game Online Bebas Lag & Ping Stabil
        </h3>
        <p class="mt-2 text-muted font-geist text-sm sm:text-base max-w-[620px] mx-auto">
          GlideXAVPN mengoptimalkan rute jaringan langsung ke server game favorit Anda. Coba gratis 7 hari tanpa komitmen.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
          <a
            href="https://play.google.com/store/apps/details?id=com.glidexa.vpn"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center rounded-lg border border-azure-51 bg-gradient-to-r from-azure-28 to-azure-64 px-6 py-3 font-mono text-sm font-medium text-white shadow-lg transition-transform hover:scale-[1.02]"
          >
            DOWNLOAD ON GOOGLE PLAY &rarr;
          </a>
          <a
            href="/#pricing"
            class="inline-flex items-center justify-center rounded-lg border border-line bg-surface px-6 py-3 font-mono text-sm font-medium text-text hover:border-ping hover:text-white"
          >
            Lihat Paket Harga
          </a>
        </div>
      </div>

      <!-- Related Articles Section -->
      {relatedArticles.length > 0 && (
        <section class="mt-20 pt-10 border-t border-line">
          <div class="flex items-center justify-between mb-8">
            <h3 class="font-mono text-xl font-medium text-strong">Artikel Pilihan Lainnya</h3>
            <a href="/blog" class="font-mono text-xs text-azure-64 hover:underline">Lihat Semua &rarr;</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((rel) => (
              <a
                href={`/blog/${rel.slug}`}
                class="group flex flex-col justify-between rounded-xl border border-line bg-surface p-5 transition-all hover:border-ping hover:shadow-lg"
              >
                <div>
                  <span class="rounded bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-soft">
                    {rel.category || 'General'}
                  </span>
                  <h4 class="mt-2 font-mono text-sm font-medium text-strong group-hover:text-ping line-clamp-2">
                    {rel.title}
                  </h4>
                  <p class="mt-2 font-geist text-xs text-muted line-clamp-2">
                    {rel.excerpt || 'Baca artikel selengkapnya...'}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-line/40 font-mono text-[11px] text-azure-64">
                  BACA &rarr;
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Bottom Nav -->
      <div class="mt-14 border-t border-line pt-8 flex items-center justify-between">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2 font-mono text-xs font-medium text-soft hover:border-ping hover:text-white"
        >
          &larr; Kembali ke Blog
        </a>
      </div>
    </main>
  </article>

  <!-- Typography & Reader Styles -->
  <style is:global>
    .reader-content {
      color: #e5e5e5;
    }
    .reader-content h1,
    .reader-content h2,
    .reader-content h3,
    .reader-content h4 {
      font-family: var(--font-mono, monospace);
      color: #fafafa;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 1rem;
      line-height: 1.35;
    }
    .reader-content h1 { font-size: 1.85rem; }
    .reader-content h2 { font-size: 1.5rem; border-bottom: 1px solid #262626; padding-bottom: 0.5rem; }
    .reader-content h3 { font-size: 1.25rem; }
    .reader-content p {
      margin-top: 1.25rem;
      margin-bottom: 1.25rem;
      line-height: 1.85;
      color: #d4d4d4;
    }
    .reader-content strong {
      color: #ffffff;
      font-weight: 600;
    }
    .reader-content ul,
    .reader-content ol {
      margin-top: 1rem;
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }
    .reader-content ul { list-style-type: disc; }
    .reader-content ol { list-style-type: decimal; }
    .reader-content li {
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
      line-height: 1.75;
      color: #d4d4d4;
    }
    .reader-content blockquote {
      border-left: 4px solid #2f72ff;
      background: #171717;
      padding: 1rem 1.25rem;
      border-radius: 0 0.5rem 0.5rem 0;
      margin: 1.5rem 0;
      font-style: italic;
      color: #e5e5e5;
    }
    .reader-content a {
      color: #4fa3f7;
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 0.15s ease;
    }
    .reader-content a:hover {
      color: #ffffff;
    }
    .reader-content img {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      border: 1px solid #404040;
      margin: 2rem auto;
      display: block;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }
    .reader-content code {
      font-family: var(--font-mono, monospace);
      background: #262626;
      color: #4fa3f7;
      padding: 0.2rem 0.45rem;
      border-radius: 6px;
      font-size: 0.88em;
    }
    .reader-content pre {
      background: #171717;
      border: 1px solid #404040;
      border-radius: 10px;
      padding: 1.25rem;
      overflow-x: auto;
      margin: 1.5rem 0;
    }
    .reader-content pre code {
      background: transparent;
      padding: 0;
      color: #e5e5e5;
    }
  </style>

  <!-- Client-side Scripts: Copy Link Toast & Fallback Hydration -->
  <script>
    // Copy link handler
    const copyBtn = document.getElementById('btn-copy-url');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyBtn.innerHTML = '<span>✅ Tersalin!</span>';
          setTimeout(() => {
            copyBtn.innerHTML = '<span>📋 Salin Link</span>';
          }, 2000);
        } catch (e) {
          alert('Link: ' + window.location.href);
        }
      });
    }

    // Dynamic Live Hydration for newly published articles
    async function hydrateArticle() {
      const root = document.querySelector('article[data-slug]');
      if (!root) return;
      const slug = root.getAttribute('data-slug');
      const apiUrl = root.getAttribute('data-api') || 'http://127.0.0.1:8787';
      if (!slug) return;

      try {
        const res = await fetch(`${apiUrl}/api/articles/${slug}`);
        if (!res.ok) return;
        const json = await res.json();
        if (!json.success || !json.data) return;

        const art = json.data;
        const titleEl = document.getElementById('article-title');
        const contentEl = document.getElementById('article-content');
        const excerptEl = document.getElementById('article-excerpt');
        const dateEl = document.getElementById('article-date');
        const catEl = document.getElementById('article-cat');

        if (titleEl) titleEl.textContent = art.title;
        if (excerptEl && art.excerpt) excerptEl.textContent = art.excerpt;
        if (catEl && art.category) catEl.textContent = art.category;
        if (dateEl && art.published_at) {
          dateEl.textContent = new Date(art.published_at).toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          });
        }

        // If thumbnail changed or added dynamically
        if (art.thumbnail_url && !document.getElementById('article-banner')) {
          const header = document.querySelector('header .glow-top');
          if (header) {
            const banner = document.createElement('div');
            banner.id = 'article-banner';
            banner.className = 'relative mt-4 w-full max-w-[920px] overflow-hidden rounded-2xl border border-line shadow-2xl';
            banner.innerHTML = `<img src="${art.thumbnail_url}" alt="${art.title}" class="w-full max-h-[460px] object-cover" />`;
            header.appendChild(banner);
          }
        }
      } catch (e) {
        // Fallback
      }
    }

    hydrateArticle();
  </script>
</Base>
